{
    "version": 2,
    "functions": {
      "server.js": {
        "runtime": "@vercel/node"
      }
    },
    "routes": [
      {
        "src": "/analyze",
        "dest": "/server.js"
      },
      {
        "src": "/",
        "dest": "/server.js"
      },
      {
        "src": "/(.*)",
        "dest": "/index.html"
      }
    ]
  }